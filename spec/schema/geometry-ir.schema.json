{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://numbrane.dev/schema/geometry-ir.schema.json",
  "title": "NAP Geometry IR (v0)",
  "description": "Tiny semantic IR for cross-language geometry contract tests. Not a universal scene graph.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "space", "primitives"],
  "properties": {
    "protocol_version": { "type": "string", "const": "0.1.0" },
    "space": {
      "type": "string",
      "enum": ["normalized-screen", "pixel", "cartesian-2d", "complex-plane"]
    },
    "primitives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["circle", "line", "polyline", "point"]
          },
          "cx": { "type": "number" },
          "cy": { "type": "number" },
          "r": { "type": "number" },
          "x1": { "type": "number" },
          "y1": { "type": "number" },
          "x2": { "type": "number" },
          "y2": { "type": "number" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "points": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "number" }
            }
          },
          "stroke": { "type": "string" },
          "fill": { "type": ["string", "null"] },
          "stroke_width": { "type": "number" }
        }
      }
    }
  }
}
