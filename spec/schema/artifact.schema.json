{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://numbrane.dev/schema/artifact.schema.json",
  "title": "NAP Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "path"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["geometry-ir", "svg", "png", "json", "wav", "webm"]
    },
    "path": { "type": "string", "minLength": 1 },
    "media_type": { "type": "string" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "notes": { "type": "string" }
  }
}
