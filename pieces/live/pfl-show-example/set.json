      "layers": [
        {
          "id": "L0",
          "piece": "flagship/latticefall",
          "opacity": 1,
          "parameters": {
            "density": 0.8,
            "chaos": 0.45,
            "pfl_style": "pfl-machine"
          }
        }
      ],
      "modulation": [
        {
          "id": "m1",
          "source": "audio.energy",
          "destination": "layer.L0.density",
          "amount": 0.35,
          "min": 0.35,
          "max": 1.25
        },
        {
          "id": "m2",
          "source": "audio.onset",
          "destination": "layer.L0.exposure",
          "amount": 0.38,
          "min": 0.5,
          "max": 1.6
        }
      ],
      "post": { "bloom": 0.2, "chromatic": 0.06 }
    },
    {
      "id": "08-afterimage",
      "name": "08 Afterimage attractor",
      "layers": [
        {
          "id": "L0",
          "piece": "fractals/strange-attractors",
          "opacity": 1,
          "parameters": {
            "render_mode": "ghost",
            "pfl_style": "pfl-afterimage",
            "palette": "ember"
          }
        }
      ],
      "modulation": [
        {
          "id": "m1",
          "source": "audio.energy",
          "destination": "layer.L0.exposure",
          "amount": 0.2,
          "min": 0.6,
          "max": 1.3
        }
      ],
      "post": { "bloom": 0.22, "feedback": 0.1, "vignette": 0.16 }
    }
