      "layers": [
        {
          "id": "L0",
          "piece": "particles/noodles",
          "opacity": 1,
          "parameters": {
            "density": 0.5,
            "pfl_style": "pfl-signal",
            "palette": "electric-cyan"
          }
        }
      ],
      "modulation": [
        {
          "id": "m1",
          "source": "audio.energy",
          "destination": "layer.L0.flow",
          "amount": 0.32,
          "min": 0.4,
          "max": 1.6
        },
        {
          "id": "m2",
          "source": "audio.onset",
          "destination": "layer.L0.chaos",
          "amount": 0.22,
          "min": 0,
          "max": 0.7
        }
      ],
      "post": { "bloom": 0.18, "chromatic": 0.04 }
    },
    {
      "id": "06-peak-machine",
