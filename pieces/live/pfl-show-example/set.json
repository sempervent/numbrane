{
  "protocol_version": "0.1.0",
  "set_id": "pfl-show-example",
  "name": "PFL / Show Example",
  "bpm": 90,
  "default_transition": { "type": "crossfade", "duration_beats": 4 },
  "scenes": [
    {
      "id": "01-quiet-void",
      "name": "01 Quiet void flow",
      "layers": [
        {
          "id": "L0",
          "piece": "fields/flow-hatching",
          "opacity": 1,
          "parameters": {
            "density": 0.45,
            "mask": "central-void",
            "pfl_style": "pfl-void",
            "palette": "monochrome-ink"
          }
        }
      ],
      "modulation": [
        {
          "id": "m1",
          "source": "audio.energy",
          "destination": "layer.L0.density",
          "amount": 0.18,
          "min": 0.3,
          "max": 0.8
        }
      ],
      "post": { "bloom": 0.08, "vignette": 0.22 }
    },
    {
      "id": "02-ritual-geometry",
      "name": "02 Ritual Metatron",
      "layers": [
        {
          "id": "L0",
          "piece": "geometry/metatron",
          "opacity": 1,
          "parameters": {
            "density": 0.58,
            "composition_mode": "construction",
            "pfl_style": "pfl-ritual",
            "palette": "bone-black"
          }
        }
      ],
      "modulation": [
        {
          "id": "m1",
          "source": "audio.onset",
          "destination": "layer.L0.density",
          "amount": 0.28,
          "min": 0.35,
          "max": 0.95
        }
      ],
      "post": { "bloom": 0.1, "vignette": 0.2 }
    },
    {
      "id": "03-organic-slime",
      "name": "03 Organism slime",
      "layers": [
        {
          "id": "L0",
          "piece": "growth/slime-mold",
          "opacity": 1,
          "parameters": {
            "density": 0.7,
            "nutrient_layout": "constellation",
            "pfl_style": "pfl-organism"
          }
        }
      ],
      "modulation": [
        {
          "id": "m1",
          "source": "audio.low",
          "destination": "layer.L0.stepSize",
          "amount": 0.28,
          "min": 0.6,
          "max": 1.7
        },
        {
          "id": "m2",
          "source": "audio.onset",
          "destination": "layer.L0.deposit",
          "amount": 0.3,
          "min": 0.5,
          "max": 1.8
        }
      ],
      "post": { "bloom": 0.14, "feedback": 0.08 }
    },
    {
      "id": "04-dense-attractor",
      "name": "04 Dense attractor",
      "layers": [
        {
          "id": "L0",
          "piece": "fractals/strange-attractors",
          "opacity": 1,
          "parameters": {
            "render_mode": "dense-ink",
            "pfl_style": "pfl-ritual",
            "palette": "bone-black"
          }
        }
      ],
      "modulation": [
        {
          "id": "m1",
          "source": "audio.energy",
          "destination": "layer.L0.density",
          "amount": 0.22,
          "min": 0.4,
          "max": 1.1
        }
      ],
      "post": { "bloom": 0.12, "vignette": 0.18 }
    },
    {
      "id": "05-sparse-signal",
