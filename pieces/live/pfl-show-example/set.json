      "layers": [
        {
          "id": "L0",
          "piece": "reaction-diffusion/reaction-diffusion",
          "opacity": 1,
          "parameters": {
            "evolved_preset": "cells",
            "pfl_style": "pfl-machine",
            "palette": "cold-technical"
          }
        }
      ],
      "modulation": [
        {
          "id": "m1",
          "source": "audio.energy",
          "destination": "layer.L0.f",
          "amount": 0.01,
          "min": 0.02,
          "max": 0.075
        },
        {
          "id": "m2",
          "source": "audio.onset",
          "destination": "layer.L0.chaos",
          "amount": 0.24,
          "min": 0,
          "max": 0.75
        }
      ],
      "post": { "bloom": 0.16 }
    },
    {
      "id": "07-collapse-lattice",
