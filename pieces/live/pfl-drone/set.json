{
  "protocol_version": "0.1.0",
  "set_id": "pfl-drone",
  "name": "PFL / Drone",
  "bpm": 68,
  "default_transition": {
    "type": "crossfade",
    "duration_beats": 8
  },
  "scenes": [
    {
      "id": "drone-attractor",
      "name": "Long exposure attractor",
      "layers": [
        {
          "id": "L0",
          "piece": "fractals/strange-attractors",
          "opacity": 1,
          "parameters": {
            "density": 0.72,
            "chaos": 0.22,
            "exposure": 1.35,
            "render_mode": "long-exposure",
            "pfl_style": "pfl-afterimage",
            "palette": "ember"
          }
        }
      ],
      "modulation": [
        {
          "id": "m1",
          "source": "audio.energy",
          "destination": "layer.L0.density",
          "amount": 0.28,
          "min": 0.35,
          "max": 1.1
        },
        {
          "id": "m2",
          "source": "audio.low",
          "destination": "layer.L0.chaos",
          "amount": 0.18,
          "min": 0.05,
          "max": 0.6
        }
      ],
      "post": {
        "bloom": 0.28,
        "feedback": 0.14,
        "vignette": 0.18
      }
    },
    {
      "id": "drone-flow",
      "name": "Sparse flow field",
      "layers": [
        {
          "id": "L0",
          "piece": "fields/flow-hatching",
          "opacity": 1,
          "parameters": {
            "density": 0.55,
            "chaos": 0.15,
            "mask": "central-void",
            "pfl_style": "pfl-void",
            "palette": "monochrome-ink"
          }
        }
      ],
      "modulation": [
        {
          "id": "m1",
          "source": "audio.flux",
          "destination": "layer.L0.chaos",
          "amount": 0.22,
          "min": 0,
          "max": 0.55
        }
      ],
      "post": {
        "bloom": 0.12,
        "feedback": 0.1
      }
    }
  ],
  "cues": []
}
