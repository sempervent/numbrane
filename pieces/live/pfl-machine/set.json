{
  "protocol_version": "0.1.0",
  "set_id": "pfl-machine",
  "name": "PFL / Machine",
  "bpm": 128,
  "default_transition": { "type": "crossfade", "duration_beats": 2 },
  "scenes": [
    {
      "id": "machine-rd",
      "name": "Reaction Diffusion",
      "layers": [
        {
          "id": "L0",
          "piece": "reaction-diffusion/reaction-diffusion",
          "opacity": 1,
          "parameters": { "density": 0.7, "chaos": 0.35 }
        }
      ],
      "modulation": [
        {
          "id": "m1",
          "source": "audio.energy",
          "destination": "layer.L0.density",
          "amount": 0.4,
          "min": 0.2,
          "max": 1
        },
        {
          "id": "m2",
          "source": "audio.onset",
          "destination": "layer.L0.exposure",
          "amount": 0.5,
          "min": 0,
          "max": 1.5
        }
      ],
      "post": { "bloom": 0.25, "feedback": 0.06 }
    },
    {
      "id": "machine-slime",
      "name": "Slime Mold",
      "layers": [
        {
          "id": "L0",
          "piece": "growth/slime-mold",
          "opacity": 1,
          "parameters": { "density": 0.8 }
        }
      ],
      "modulation": [
        {
          "id": "m1",
          "source": "audio.low",
          "destination": "layer.L0.stepSize",
          "amount": 0.4,
          "min": 0.5,
          "max": 2
        },
        {
          "id": "m2",
          "source": "audio.energy",
          "destination": "layer.L0.deposit",
          "amount": 0.45,
          "min": 0.5,
          "max": 2
        }
      ],
      "post": { "bloom": 0.2 }
    }
  ],
  "cues": []
}
